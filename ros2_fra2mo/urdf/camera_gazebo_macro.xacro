<?xml version="1.0"?>
<!--
  RGB camera for Gazebo Fortress (CW3 Task 4).
  The course d435_gazebo_macro.xacro uses libgazebo_ros_depth_camera.so (Gazebo Classic):
  it does not work in Fortress, so a native Fortress "camera" sensor is mounted on the
  existing d435_link, moved 3.5 cm forward (d435_camera_link) to clear the robot shell.

  Gazebo topics (bridged to ROS in gazebo_fra2mo.launch.py):
    camera/image        sensor_msgs/Image
    camera/camera_info  sensor_msgs/CameraInfo   (Fortress derives it from <topic>)
  frame_id of both = d435_optical_frame (REP-103 optical convention: z forward, x right, y down)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera_gazebo_macro">

  <xacro:macro name="camera_gazebo_sensor" params="parent forward_offset:=0.035">

    <!-- Camera body: d435_link (x 0.091 m from the robot centre) lies inside the robot shell
         (radius ~0.11 m), so the sensor would see the inside of the body. Move it forward. -->
    <link name="d435_camera_link"/>
    <joint name="d435_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="d435_camera_link"/>
      <origin xyz="${forward_offset} 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Optical frame: the camera looks along +x of d435_camera_link; the image frame has z forward -->
    <link name="d435_optical_frame"/>
    <joint name="d435_optical_joint" type="fixed">
      <parent link="d435_camera_link"/>
      <child link="d435_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="d435_camera_link">
      <sensor name="d435_color" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>camera/image</topic>
        <ignition_frame_id>d435_optical_frame</ignition_frame_id>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>   <!-- 80 deg, as the course D435 macro -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
