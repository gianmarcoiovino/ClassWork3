<?xml version="1.0" ?>
<sdf version="1.4">
  <model name="marker_3">
    <static>true</static>
    <link name="marker">
      <gravity>false</gravity>
      <visual name="tag">
        <geometry>
          <box>
            <size>0.30 0.30 0.002</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://marker_3/material/scripts</uri>
            <uri>model://marker_3/material/textures</uri>
            <name>marker_3</name>
          </script>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <!-- Gazebo Fortress ignores Ogre material scripts: texture as PBR albedo map -->
          <pbr>
            <metal>
              <albedo_map>model://marker_3/material/textures/ar_tag_3.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="support">
        <geometry>
          <box>
            <size>0.32 0.32 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material> 
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.32 0.32 0.001</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

